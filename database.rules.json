{
  "rules": {
    ".read": false,
    ".write": false,

    "roles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "devices": {
      "$deviceId": {
        "live": {
          ".read": true,
          ".write": "auth != null && (auth.token.email === 'device@sunflower.com' || root.child('roles').child(auth.uid).val() === 'device')",
          ".validate": "newData.hasChildren()",
          "device_id": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "mode": { ".validate": "newData.val() === 'auto' || newData.val() === 'manual'" },
          "azimuth_deg": { ".validate": "newData.isNumber() && newData.val() >= -360 && newData.val() <= 360" },
          "elevation_deg": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 180" },
          "telemetry": {
            "$param": { ".validate": "newData.isNumber() || (newData.isString() && newData.val().matches(/^-?[0-9]+(\\.[0-9]+)?$/))" }
          },
          "ldr_sensors": {
            "$side": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4095" }
          },
          "ts": { ".validate": "newData.isNumber()" },
          "rssi_dbm": { ".validate": "newData.isNumber()" },
          "estop": { ".validate": "newData.isBoolean()" },
          "last_cmd_id": { ".validate": "newData.isNumber()" },
          "sim_minutes": { ".validate": "newData.isNumber()" },
          "sim_doy": { ".validate": "newData.isNumber()" }
        },

        "history": {
          ".read": true,
          ".write": "auth != null && (auth.token.email === 'device@sunflower.com' || root.child('roles').child(auth.uid).val() === 'device')",
          ".indexOn": ["ts"],
          "$entry": {
            ".validate": "newData.hasChildren()",
            "device_id": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "mode": { ".validate": "newData.val() === 'auto' || newData.val() === 'manual'" },
            "azimuth_deg": { ".validate": "newData.isNumber() && newData.val() >= -360 && newData.val() <= 360" },
            "elevation_deg": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 180" },
            "telemetry": {
              "$param": { ".validate": "newData.isNumber() || (newData.isString() && newData.val().matches(/^-?[0-9]+(\\.[0-9]+)?$/))" }
            },
            "ldr_sensors": {
              "$side": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4095" }
            },
            "ts": { ".validate": "newData.isNumber()" },
            "rssi_dbm": { ".validate": "newData.isNumber()" },
            "estop": { ".validate": "newData.isBoolean()" },
            "last_cmd_id": { ".validate": "newData.isNumber()" },
            "sim_minutes": { ".validate": "newData.isNumber()" },
            "sim_doy": { ".validate": "newData.isNumber()" }
          }
        },

        "control": {
          ".read": "auth != null && (root.child('roles').child(auth.uid).val() === 'operator' || auth.token.email === 'device@sunflower.com' || root.child('roles').child(auth.uid).val() === 'device')",
          ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'operator'",
          "mode": { ".validate": "newData.val() === 'auto' || newData.val() === 'manual'" },
          "target_az": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 360" },
          "target_el": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 90" },
          "estop": { ".validate": "newData.isBoolean()" },
          "cmd_id": { ".validate": "newData.isNumber()" },
          "updated_by": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "updated_at": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
